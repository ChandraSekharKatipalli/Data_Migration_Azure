{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-mydev-data-pipelines"
		},
		"AzureSqlDatabase1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase1'"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserver-mydev-cus.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorks"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "chandra-admin"
		},
		"SqlServerQuality_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "DESKTOP-787K5FA\\QUALITY"
		},
		"SqlServerQuality_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorks2022"
		},
		"SqlServerQuality_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "DESKTOP-787K5FA\\user"
		},
		"WindowAuth_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://WindowAuth.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-mydev-data-pipelines_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSqlDatabase1_password": {
						"value": "[parameters('AzureSqlDatabase1_password')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"WindowAuth_properties_typeProperties_baseUrl": {
						"value": "[parameters('WindowAuth_properties_typeProperties_baseUrl')]"
					},
					"SqlServerQuality_properties_typeProperties_server": {
						"value": "[parameters('SqlServerQuality_properties_typeProperties_server')]"
					},
					"SqlServerQuality_properties_typeProperties_database": {
						"value": "[parameters('SqlServerQuality_properties_typeProperties_database')]"
					},
					"SqlServerQuality_properties_typeProperties_userName": {
						"value": "[parameters('SqlServerQuality_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}