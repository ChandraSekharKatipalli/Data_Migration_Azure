{
	"name": "DF_Incremental_Sync",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Param_OnPremSQL_Table",
						"type": "DatasetReference"
					},
					"name": "ScoreOnPrem"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Param_AzureSQL_Table",
						"type": "DatasetReference"
					},
					"name": "DestAzure"
				}
			],
			"transformations": [
				{
					"name": "AlterRowSalesHeader"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     enableNativeCdc: true,",
				"     netChanges: true,",
				"     skipInitialLoad: true,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> ScoreOnPrem",
				"ScoreOnPrem alterRow(insertIf(isInsert(1)),",
				"     upsertIf(isUpsert(1)),",
				"     deleteIf(isDelete(1))) ~> AlterRowSalesHeader",
				"AlterRowSalesHeader sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:true,",
				"     insertable:true,",
				"     updateable:true,",
				"     upsertable:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> DestAzure"
			]
		}
	}
}